# Porta local
PORT=3000

# Segredo da sessão (gere um valor longo e aleatório)
COOKIE_SECRET=troque-por-um-valor-aleatorio-longo-antes-de-usar-em-producao

# Em produção use production; localmente use development
NODE_ENV=development

# PostgreSQL. Em produção, cole aqui a URL fornecida pelo seu provedor.
# Se ficar vazia/ausente, o app continua usando data/*.json localmente.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Normalmente deixe require em hospedagens gerenciadas.
# Para PostgreSQL local sem SSL, use: PGSSL=disable
PGSSL=require

# Taagzinho: chave somente no servidor. Nunca coloque em public/ ou no GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
